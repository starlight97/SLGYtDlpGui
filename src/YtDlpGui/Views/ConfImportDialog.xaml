<Window x:Class="YtDlpGui.Views.ConfImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from yt-dlp.conf"
        Width="720" Height="540"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,10">
      <StackPanel>
        <TextBlock Text="Source file" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
        <TextBlock Text="{Binding FilePath, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontSize="11"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath, Mode=OneWay}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="14,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Margin="0,0,7,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#EAF6E6" Padding="10,6" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TextBlock>
              <!-- Header bg is hardcoded pastel; keep all inner text hardcoded too so contrast holds in both themes. -->
              <Run Text="Applied" FontWeight="SemiBold" Foreground="#1F6F1F" />
              <Run Text=" (" Foreground="#555" />
              <Run Text="{Binding AppliedCount, Mode=OneWay}" Foreground="#555" />
              <Run Text=")" Foreground="#555" />
            </TextBlock>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Applied}"
                   FontFamily="Consolas, Cascadia Mono" FontSize="11"
                   BorderThickness="0" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Margin="7,0,0,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#FBEEE2" Padding="10,6" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TextBlock>
              <Run Text="Unrecognized" FontWeight="SemiBold" Foreground="#9A4F00" />
              <Run Text=" (" Foreground="#555" />
              <Run Text="{Binding UnrecognizedCount, Mode=OneWay}" Foreground="#555" />
              <Run Text=")" Foreground="#555" />
            </TextBlock>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Unrecognized}"
                   FontFamily="Consolas, Cascadia Mono" FontSize="11"
                   BorderThickness="0" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center"
                   Text="Apply will overwrite the matching options in the panel. Unrecognized flags are NOT applied." />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Cancel" Padding="14,4" MinWidth="84" IsCancel="True" Click="Cancel_Click" />
          <Button Content="Apply"  Padding="14,4" MinWidth="84" Margin="8,0,0,0" IsDefault="True" Click="Apply_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
