<Window x:Class="YtDlpGui.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="640" Height="460"
        MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="14,10">
      <StackPanel>

        <TextBlock Text="yt-dlp.exe path (override)" Style="{StaticResource SectionLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding YtDlpPathOverride, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
          <Button Grid.Column="1" Content="Browse…" Padding="10,4" Margin="6,0,0,0"
                  Command="{Binding BrowseYtDlpCommand}" />
        </Grid>
        <TextBlock Text="Empty = auto-detect (next to app, repo root, or PATH)."
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="10" Margin="0,2,0,0" />

        <TextBlock Text="ffmpeg.exe path (override)" Style="{StaticResource SectionLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding FfmpegPathOverride, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
          <Button Grid.Column="1" Content="Browse…" Padding="10,4" Margin="6,0,0,0"
                  Command="{Binding BrowseFfmpegCommand}" />
        </Grid>
        <TextBlock Text="Empty = auto-detect."
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="10" Margin="0,2,0,0" />

        <TextBlock Text="Output folder" Style="{StaticResource SectionLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding DefaultOutputFolder, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
          <Button Grid.Column="1" Content="Browse…" Padding="10,4" Margin="6,0,0,0"
                  Command="{Binding BrowseDefaultOutputFolderCommand}" />
        </Grid>
        <TextBlock Text="Authoritative — saved here applies to the Options panel and survives across restarts. Per-session edits in the Options panel are temporary."
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Default parallelism" Style="{StaticResource SectionLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider Grid.Column="0" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding Parallelism, Mode=TwoWay}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Parallelism}" MinWidth="20"
                     VerticalAlignment="Center" Margin="10,0,0,0" />
        </Grid>

        <TextBlock Text="Theme" Style="{StaticResource SectionLabel}" />
        <ComboBox SelectedValue="{Binding Theme, Mode=TwoWay}" SelectedValuePath="Content" Padding="6,4">
          <ComboBoxItem Content="System" />
          <ComboBoxItem Content="Light" />
          <ComboBoxItem Content="Dark" />
        </ComboBox>

        <TextBlock Text="yt-dlp.conf" Style="{StaticResource SectionLabel}" />
        <Button HorizontalAlignment="Left" Padding="10,4"
                Content="Import from .conf…"
                Command="{Binding ImportConfCommand}" />
        <TextBlock Text="One-way import (SPEC §4.1). After import, the GUI fully owns the options; the conf file is not touched again."
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />

        <Border Margin="0,18,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
          <StackPanel>
            <TextBlock Text="About" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
            <TextBlock>
              <Run Text="App version:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Run Text="{Binding AppVersion, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,2,0,0">
              <Run Text="yt-dlp:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Run Text="{Binding YtDlpVersion, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontSize="11" />
            </TextBlock>
            <TextBlock Margin="0,2,0,0">
              <Run Text="ffmpeg:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Run Text="{Binding FfmpegVersion, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontSize="11" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Padding="10,4" Content="Check versions"
                      Command="{Binding CheckVersionsCommand}" />
              <Button Padding="10,4" Margin="6,0,0,0" Content="Update yt-dlp (-U)"
                      Command="{Binding SelfUpdateYtDlpCommand}" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontSize="11" FontFamily="Consolas, Cascadia Mono"
                       TextWrapping="Wrap"
                       Text="{Binding SelfUpdateStatus, Mode=OneWay}" />

            <TextBlock Margin="0,12,0,0">
              <Run Text="Settings file:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Run Text="{Binding SettingsFilePath, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontSize="11" />
            </TextBlock>
            <TextBlock Margin="0,2,0,0">
              <Run Text="Log folder:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Run Text="{Binding LogFolderPath, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontSize="11" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Padding="10,4" Content="Open settings folder"
                      Command="{Binding OpenSettingsFolderCommand}" />
              <Button Padding="10,4" Margin="6,0,0,0" Content="Open log folder"
                      Command="{Binding OpenLogFolderCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Padding="14,4" MinWidth="84" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Content="Save" Padding="14,4" MinWidth="84" Margin="8,0,0,0"
                Command="{Binding ApplyCommand}" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
