<Window x:Class="YtDlpGui.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="640" Height="460"
        MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,4" />
      <Setter Property="Foreground" Value="#444" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Resources>

  <Grid Background="#F5F5F5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="14,10">
      <StackPanel>

        <TextBlock Text="yt-dlp.exe path (override)" Style="{StaticResource SectionLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding YtDlpPathOverride, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
          <Button Grid.Column="1" Content="Browse…" Padding="10,4" Margin="6,0,0,0"
                  Command="{Binding BrowseYtDlpCommand}" />
        </Grid>
        <TextBlock Text="Empty = auto-detect (next to app, repo root, or PATH)."
                   Foreground="#888" FontSize="10" Margin="0,2,0,0" />

        <TextBlock Text="ffmpeg.exe path (override)" Style="{StaticResource SectionLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding FfmpegPathOverride, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
          <Button Grid.Column="1" Content="Browse…" Padding="10,4" Margin="6,0,0,0"
                  Command="{Binding BrowseFfmpegCommand}" />
        </Grid>
        <TextBlock Text="Empty = auto-detect."
                   Foreground="#888" FontSize="10" Margin="0,2,0,0" />

        <TextBlock Text="Default output folder" Style="{StaticResource SectionLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding DefaultOutputFolder, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
          <Button Grid.Column="1" Content="Browse…" Padding="10,4" Margin="6,0,0,0"
                  Command="{Binding BrowseDefaultOutputFolderCommand}" />
        </Grid>
        <TextBlock Text="Used as the seed for the Options panel only on first run (when no LastOptions has been saved yet)."
                   Foreground="#888" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Default parallelism" Style="{StaticResource SectionLabel}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider Grid.Column="0" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding Parallelism, Mode=TwoWay}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Parallelism}" MinWidth="20"
                     VerticalAlignment="Center" Margin="10,0,0,0" />
        </Grid>

        <Border Margin="0,18,0,0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
          <StackPanel>
            <TextBlock>
              <Run Text="App version:" Foreground="#666" />
              <Run Text="{Binding AppVersion, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,4,0,0">
              <Run Text="Settings file:" Foreground="#666" />
              <Run Text="{Binding SettingsFilePath, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontSize="11" />
            </TextBlock>
            <Button HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4"
                    Content="Open settings folder"
                    Command="{Binding OpenSettingsFolderCommand}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="14,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Padding="14,4" MinWidth="84" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Content="Save" Padding="14,4" MinWidth="84" Margin="8,0,0,0"
                Command="{Binding ApplyCommand}" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
